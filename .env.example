APP_SCHEME=http
APP_HOST=127.0.0.1
APP_BIND_HOST=0.0.0.0
APP_LOOPBACK_HOST=127.0.0.1

FRONTEND_PORT=3000
EDUCATION_API_PORT=8001
MAINTENANCE_API_PORT=8002
BACKEND_ADMIN_PORT=8080

APP_STUDENT_USERNAME=student
APP_STUDENT_PASSWORD=
APP_STUDENT_ID=student_001

APP_TEACHER_USERNAME=teacher
APP_TEACHER_PASSWORD=
APP_TEACHER_ID=teacher_001

MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000

# 默认运行只使用项目目录内的源码、模型、索引和缓存路径。
KGTS_PROJECT_LOCAL_ONLY=1
KGTS_ALLOW_EXTERNAL_PATHS=0

# 本地默认使用 GraphRAG hybrid：FAISS embedding 向量索引 + 图关系扩展/重排。
# Azure F1 可改为 "sparse_hybrid" 或 "graph_db" 以避免安装重型向量依赖。
KGTS_RETRIEVAL_MODE=hybrid
KGTS_VECTOR_INDEX_DIR=.runtime/vector_index
KGTS_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
KGTS_EMBEDDING_CACHE_DIR=.runtime/huggingface
KGTS_EMBEDDING_LOCAL_FILES_ONLY=1
KGTS_VECTOR_TOP_K_MULTIPLIER=3
KGTS_VECTOR_STARTUP_ENSURE=0
KGTS_VECTOR_UNLOAD_AFTER_QUERY=0
KGTS_VECTOR_UNLOAD_AFTER_REBUILD=0

# 本地可选语音推理。默认使用项目内 Genie-TTS 推理特化和 shu 模型；Azure F1 建议保持禁用。
KGTS_TTS_ENABLED=1
KGTS_TTS_PROVIDER=genie
KGTS_TTS_GENIE_DATA_DIR=models/tts/GenieData
KGTS_TTS_MODEL_DIR=models/tts/shu
KGTS_TTS_CHARACTER_NAME=shu
KGTS_TTS_LANGUAGE=zh
KGTS_TTS_REFERENCE_AUDIO=models/tts/shu/reference/shu.wav
KGTS_TTS_REFERENCE_LANGUAGE=zh
KGTS_TTS_REFERENCE_TEXT=我是谁？答案只在于我所见所遇的一切。
KGTS_TTS_GPT_SOVITS_ROOT=.runtime/tts/gpt-sovits
# 低内存 VM 可改用 KGTS_TTS_PROVIDER=genie_server，并单独运行 scripts/genie_tts_proxy_server.py。
KGTS_TTS_SERVER_URL=http://127.0.0.1:9880
KGTS_TTS_PROXY_UNLOAD_AFTER_SYNTH=0
KGTS_TTS_PROXY_EXIT_AFTER_SYNTH=0
