APP_SCHEME=http
APP_HOST=127.0.0.1
APP_BIND_HOST=0.0.0.0
APP_LOOPBACK_HOST=127.0.0.1

FRONTEND_PORT=3000
EDUCATION_API_PORT=8001
MAINTENANCE_API_PORT=8002
BACKEND_ADMIN_PORT=8080

APP_STUDENT_USERNAME=student
APP_STUDENT_PASSWORD=
APP_STUDENT_ID=student_001

APP_TEACHER_USERNAME=teacher
APP_TEACHER_PASSWORD=
APP_TEACHER_ID=teacher_001

MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000

# 检索默认使用 SQLite 图谱 + 轻量文本打分。
# Azure F1 可使用 "sparse_hybrid" 启用免费的无模型图谱向量式检索。
# 本地或高资源部署可安装 requirements-vector.txt 后使用 "hybrid"。
KGTS_RETRIEVAL_MODE=graph_db
KGTS_VECTOR_INDEX_DIR=.runtime/vector_index
KGTS_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
KGTS_VECTOR_TOP_K_MULTIPLIER=3
